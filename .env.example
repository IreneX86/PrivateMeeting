# Frontend values are PUBLIC and embedded at build time. Never put privileged secrets here.
# Local dev defaults to ws://localhost:8787/signal; production must set a wss:// URL.
VITE_SIGNALING_URL=ws://localhost:8787/signal
# Relative assets work on GitHub project Pages; use /PrivateMeeting/ explicitly if preferred.
VITE_BASE_PATH=./
# Comma-separated URLs. Set empty to disable STUN. Replace with your own service if desired.
VITE_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN; all three required when enabled. These credentials ARE visible to visitors.
# Use scoped, quota-limited demo credentials only. For production integrate a trusted
# credential endpoint returning short-lived TURN credentials; no provider master secret here.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Server-only values, set on the signaling host. Vite does not expose these.
# Server reads process environment (not this file automatically).
PORT=8787
# Exact frontend origins (scheme + hostname + optional port, NO path or trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production requires HTTPS origins and explicit ALLOWED_ORIGINS.
NODE_ENV=development
