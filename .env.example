# FRONTEND: PUBLIC build-time Vite settings. Never include API/admin/master secrets.
# Development default: ws://localhost:8787/signal. Production: wss://HOST/signal.
# No credentials, query parameters, or fragment in this endpoint.
VITE_SIGNALING_URL=ws://localhost:8787/signal
# Relative assets + hash routing support /PrivateMeeting/ and custom domains.
VITE_BASE_PATH=./
# Comma-separated STUN URLs. Explicit empty disables STUN for local testing.
# Legacy VITE_STUN_URL remains accepted only when VITE_STUN_URLS is absent.
VITE_STUN_URLS=stun:stun.l.google.com:19302
# Optional comma-separated TURN fallback URLs; set all three variables below.
# Legacy VITE_TURN_URL remains accepted only when VITE_TURN_URLS is absent.
# Ordinary browser credentials ARE public.
# For public use, prefer temporary credentials from a trusted backend endpoint.
# Never put your TURN provider's API/admin key or shared signing secret here.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# BACKEND: process environment; never exposed by Vite. The server does not load
# this file automatically. Export values or use the hosting platform's settings.
NODE_ENV=development
PORT=8787
# Exact canonical origins, no paths/trailing slash/wildcards. Production requires
# explicit HTTPS origins, e.g. ALLOWED_ORIGINS=https://irenex86.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ROOMS=1000
MAX_CONNECTIONS=2200
MAX_CONNECTIONS_PER_IP=20
# Per-source attempt burst/refill budget, including rejected upgrades.
CONNECTIONS_PER_MINUTE=60
# Optional EXACT IP addresses of trusted reverse proxies, comma-separated.
# Empty means X-Forwarded-For is ignored (quotas apply to the direct socket peer).
# Configure only when ingress is controlled and proxies sanitize/append this header.
# Never trust arbitrary clients, a wildcard, or a guessed provider proxy address.
TRUSTED_PROXY_IPS=
